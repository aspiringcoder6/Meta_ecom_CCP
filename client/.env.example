# URL public của backend khi frontend và backend được deploy riêng.
# Có thể nhập origin hoặc URL kết thúc bằng /api; ứng dụng sẽ tự chuẩn hóa.
# Ví dụ: https://meta-ecom-api.onrender.com
# Khi chạy local có thể để trống để Vite proxy /api tới http://localhost:4000.
VITE_API_URL=
# OAuth 2.0 Web Client ID trong Google Cloud Console (không phải API key/Client Secret).
VITE_GOOGLE_CLIENT_ID=
