DATABASE_URL="postgresql://postgres:password@localhost:5432/meta_ecom?schema=public"
# Chỉ cần cho local Prisma Postgres khi DATABASE_URL bắt đầu bằng prisma+postgres://.
DIRECT_URL=""
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_EXPIRES_IN="30d"
ADMIN_EMAIL="admin@metaecom.vn"
ADMIN_USERNAME="admin"
# Tối thiểu 12 ký tự. Server sẽ tạo/cập nhật default Admin khi khởi động.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="Meta Ecom Admin"
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
