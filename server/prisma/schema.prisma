// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CAMPAIGN_MANAGER
  MEMBER
  VIEWER
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  username        String?        @unique
  name            String
  passwordHash    String?        @map("password")
  role            Role?
  status          UserStatus     @default(PENDING)
  provider        AuthProvider   @default(LOCAL)
  googleSubject   String?        @unique
  avatarUrl       String?
  department      String?
  emailVerified   Boolean        @default(false)
  rejectionReason String?
  tokenVersion    Int            @default(0)
  lastLoginAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?          @relation("UserReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedUsers   User[]         @relation("UserReviews")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]

  @@index([status])
  @@index([role])
}

model Creator {
  id                 String            @id @default(uuid())
  name               String
  tiktokLink         String            @map("channelLink")
  tiktokId           String            @unique
  segment            String?
  tier               String?
  category           String?
  type               String?
  cost               Decimal           @default(0) @db.Decimal(18, 2)
  extraCost          Decimal           @default(0) @db.Decimal(18, 2)
  followers          Int               @default(0)
  gmvMonth           Decimal           @default(0) @db.Decimal(18, 2)
  scope              String?
  contact            String?
  historicalCampaign String            @default("Chưa hợp tác")
  mcnNote            String?
  engagement         Decimal           @default(0) @db.Decimal(8, 2)
  status             String            @default("Available")
  bookingPrice       Decimal?          @db.Decimal(18, 2)
  phone              String?
  email              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  campaigns          CampaignCreator[]

  @@index([category])
  @@index([segment])
  @@index([status])
}

model Campaign {
  id          String            @id @default(uuid())
  name        String
  client      String
  startDate   DateTime
  endDate     DateTime
  budget      Decimal?
  description String?
  status      String            @default("active")
  createdAt   DateTime          @default(now())
  creators    CampaignCreator[]
  milestones  Milestone[]
}

model CampaignCreator {
  id           String        @id @default(uuid())
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  campaignId   String
  creator      Creator       @relation(fields: [creatorId], references: [id])
  creatorId    String
  deliverables Deliverable[]
}

model Deliverable {
  id                String          @id @default(uuid())
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id])
  campaignCreatorId String
  status            String          @default("not_started")
  deadline          DateTime?
  demoUrl           String?
}

model Milestone {
  id         String   @id @default(uuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  title      String
  dueDate    DateTime
}

model ReviewLink {
  id         String           @id @default(uuid())
  token      String           @unique
  campaignId String
  expiresAt  DateTime
  revoked    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  feedback   ClientFeedback[]
}

model ClientFeedback {
  id           String     @id @default(uuid())
  reviewLink   ReviewLink @relation(fields: [reviewLinkId], references: [id])
  reviewLinkId String
  action       String // "approved" | "rejected" | "revision_requested"
  comment      String?
  createdAt    DateTime   @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}
